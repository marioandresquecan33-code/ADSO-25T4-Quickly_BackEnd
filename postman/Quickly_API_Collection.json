{
  "info": {
    "name": "Quickly API REST - Coleccion Completa",
    "description": "Coleccion CRUD para Categorias, Productos, Clientes, Usuarios, Login y Facturas.",
    "schema": "https://schema.get://postman.com"
  },
  "item": [
    {
      "name": "1. Categorias",
      "item": [
        {
          "name": "Listar Categorias (GET)",
          "request": {
            "method": "GET",
            "url": "http://localhost:5002/api/categorias"
          }
        },
        {
          "name": "Crear Categoria (POST)",
          "request": {
            "method": "POST",
            "header": [
              {
                "key": "Content-Type",
                "value": "application/json"
              }
            ],
            "body": {
              "mode": "raw",
              "raw": "{\"nombre\": \"Electronica\", \"descripcion\": \"Equipos tecnologicos\"}"
            },
            "url": "http://localhost:5002/api/categorias"
          }
        },
        {
          "name": "Actualizar Categoria (PUT)",
          "request": {
            "method": "PUT",
            "header": [
              {
                "key": "Content-Type",
                "value": "application/json"
              }
            ],
            "body": {
              "mode": "raw",
              "raw": "{\"nombre\": \"Electronica Pro\", \"descripcion\": \"Actualizado\"}"
            },
            "url": "http://localhost:5002/api/categorias/1"
          }
        },
        {
          "name": "Eliminar Categoria (DELETE)",
          "request": {
            "method": "DELETE",
            "url": "http://localhost:5002/api/categorias/1"
          }
        }
      ]
    },
